# ── 네이티브 앱 전용 (웹 빌드에 번들링됨, 웹 배포 시 설정 불필요) ──────────────
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_VISION_API_KEY=your_vision_api_key_here
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here
EXPO_PUBLIC_FOOD_SAFETY_API_KEY=your_food_safety_api_key_here

# ── 서버 전용 (Vercel 환경변수로만 설정, 절대 EXPO_PUBLIC_ 접두사 사용 금지) ──
# 웹 배포 시 Vercel 대시보드 > Settings > Environment Variables에 설정
GEMINI_API_KEY=your_gemini_api_key_here
